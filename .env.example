# Use a URL-safe password, or URL-encode special characters in the password.
DATABASE_URL=mysql://ai_chater_app:REPLACE_WITH_PASSWORD@127.0.0.1:3306/ai_chater
SESSION_TTL_DAYS=30
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=10485760

# apiKeyEnv names the variable that holds each preset's API key.
AI_PRESETS_JSON=[{"id":"grok","label":"Grok","provider":"openai-compatible","model":"grok-4","apiKeyEnv":"XAI_API_KEY","baseUrl":"https://api.x.ai/v1","supportsImages":true}]
XAI_API_KEY=

# Required for user-managed model credentials. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AI_CONFIG_ENCRYPTION_KEY=

# User connection presets use only these exact OpenAI-compatible endpoints.
# Reused by text and image connections. Add only endpoints trusted by the administrator.
USER_AI_ALLOWED_BASE_URLS=["https://api.x.ai/v1","https://www.yyapi.cloud/v1","https://openrouter.ai/api/v1","https://api.deepseek.com/v1"]
# Optional extra hosts from which Provider-returned image URLs may be downloaded.
USER_IMAGE_ALLOWED_OUTPUT_HOSTS=[]

# Account-level limits, stored transactionally in MySQL. Values are requests per hour.
MODEL_CONFIG_MUTATION_LIMIT_PER_HOUR=30
MODEL_CHAT_TEST_LIMIT_PER_HOUR=10
MODEL_IMAGE_TEST_LIMIT_PER_HOUR=3
MODEL_IMAGE_GENERATION_LIMIT_PER_HOUR=20
MODEL_AUDIT_RETENTION_DAYS=180
